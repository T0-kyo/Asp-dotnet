{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "CacheSettings": {
    "GetUrlLimit": 10,
    "GetAllTtlMinutes": 2,
    "GetAllJitterMinValue": 0,
    "GetAllJitterMaxValue": 31,
    
    "GetUrlTtlHours": 2,
    "GetUrlJitterMinValue": 0,
    "GetUrlJitterMaxValue": 31
  },

  "FilterSettings": {
    "MaxPageSize": 50
  },

  "UrlDefaultSettings": {
    "UrlRandomValues": 7,
    "UrlExpireInDays": 7,
    "DefaultCreator": "Unknown",
    "UrlGenerationMaxAttempts": 5
  },

  "RateLimiterSettings": {
    "MaxRequests": 60,
    "WindowTtlMinutes": 1
  },

  "BackgroundSettings": {
    "RepositoryCleanupIntervalDays": 1,
    "VisitCountFlushIntervalSeconds": 10
  },

  "IdempotencySettings": {
    "TtlHours": 24,
    "StaleProcessingMinutes": 2,
    "CleanupIntervalMinutes": 15
  },

  "AllowedHosts": "*"
}

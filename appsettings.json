{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "CacheSettings": {
    "GetAllTtlMinutes": 2,
    "GetUrlTtlHours": 2
  },

  "FilterSettings": {

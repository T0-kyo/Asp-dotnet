{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "CacheSettings": {
    "GetAllTtlMinutes": 2,
    "GetAllJitterMinValue": 0,
    "GetAllJitterMaxValue": 31,
    
    "GetUrlTtlHours": 2,
    "GetUrlJitterMinValue": 0,
    "GetUrlJitterMaxValue": 31
  },

  "FilterSettings": {
    "MaxPageSize": 50
  },

  "UrlDefaultSettings": {
    "UrlRandomValues": 7,
    "DefaultCreator": "Unknown"
  },

  "RateLimiterSettings": {
    "MaxRequests": 60,
    "WindowTtlMinutes": 1
  },

  "AllowedHosts": "*"
}
